    {
      "id": "before",
      "title": "Before: a task in the LIFO slot could not be stolen",
      "kicker": "Before",
      "durationMs": 22000,
      "narration": "Each worker kept its last-notified task in a private lifo_slot. Idle workers could steal from the run queue but never from that slot, so if the notifier blocked, the notified task was stranded.",
      "cues": [
        {
          "atMs": 0,
          "text": "Worker A keeps a LIFO slot for the task it notified last, so that task runs next."
        },
        {
          "atMs": 4000,
          "text": "The slot is a plain Option field on worker A's Core. Only worker A can read or write it."
        },
        {
          "atMs": 8000,
          "text": "A blocker task notifies a victim, which lands in the slot, then blocks without yielding."
        },
        {
          "atMs": 12000,
          "text": "Idle worker B steals from A's run queue: half its tasks, via the shared queue::Inner."
        },
        {
          "atMs": 16000,
          "text": "But the slot is invisible to B. If A's queue is empty, steal_into returns None and the victim waits."
        }
      ],
