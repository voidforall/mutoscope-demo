    {
      "id": "steal-fallback",
      "title": "Stealers take the LIFO task only when the queue yields nothing",
      "kicker": "The change",
      "durationMs": 20000,
      "narration": "steal_into still steals half the queue first. Only when that steals nothing does it take the victim's LIFO task and run it. Review moved the PR to this simpler rule.",
      "cues": [
        {
          "atMs": 0,
          "text": "steal_into still steals half of the target's run queue first."
        },
        {
          "atMs": 4000,
          "text": "New: if that stole nothing, take the target's LIFO task, count it as a steal, and return it to run."
        },
        {
          "atMs": 9000,
          "text": "The PR description planned to grab the LIFO task on every steal. Review (commit c47b9c8) narrowed it to this fallback."
        },
        {
          "atMs": 14000,
          "text": "So a busy worker keeps its LIFO task until stealers have drained its queue, roughly log(n) steals."
        }
      ],
