      "id": "slot-moves",
      "title": "The change: the slot moves into the shared queue",
      "kicker": "The change",
      "durationMs": 22000,
      "narration": "The PR deletes lifo_slot from Core and adds an AtomicNotified field to the queue's shared Inner. The worker now pushes and pops it through the queue, and the cell swaps a raw task pointer atomically.",
      "cues": [
        {
          "atMs": 0,
          "text": "Start from the same picture: the slot lives in worker A's private Core."
        },
        {
          "atMs": 3000,
          "text": "The PR deletes Core::lifo_slot and adds lifo: AtomicNotified to queue::Inner."
        },
        {
          "atMs": 7000,
          "text": "Now Local and Steal both reach it. The worker calls push_lifo and pop_lifo instead of a field."
        },
        {
          "atMs": 13000,
          "text": "AtomicNotified is an AtomicPtr to the task header. Every access is one atomic swap, with SeqCst ordering."
        },
        {
          "atMs": 18000,
          "text": "When to use the slot (lifo_enabled, the 3-poll cap) stays in the worker, as before."
        }
