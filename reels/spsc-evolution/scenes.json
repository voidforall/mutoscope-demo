    {
      "id": "mutex-baseline",
      "title": "One lock guards everything",
      "kicker": "Before",
      "durationMs": 16000,
      "narration": "The baseline Mutex queue is a ring buffer behind a single std::mutex. Every push and every pop takes the same lock, so the producer and consumer threads take turns even though each one only ever writes its own cursor.",
      "cues": [
        {
          "atMs": 0,
          "text": "A ring buffer shared by a producer and a consumer thread."
        },
        {
          "atMs": 3000,
          "text": "Both sides must take the same std::mutex first."
        },
        {
          "atMs": 7000,
          "text": "push() holds the lock for the whole operation."
        },
        {
          "atMs": 12000,
          "text": "Each thread only writes its own cursor — the lock is stricter than needed."
        }
      ],
      "entities": [
