    {
      "id": "drop-the-lock",
      "title": "push() without a lock",
      "kicker": "The change",
      "durationMs": 15000,
      "narration": "Fifo3 deletes the mutex. push now reads its own cursor relaxed, reads the consumer's cursor with acquire, constructs the element, and publishes it with a single release store.",
      "cues": [
        {
          "atMs": 0,
          "text": "Mutex::push on the left, Fifo3::push on the right."
        },
        {
          "atMs": 4000,
          "text": "The lock_guard is gone."
        },
        {
          "atMs": 8000,
          "text": "Two atomic loads replace it, with explicit memory orders."
        },
        {
          "atMs": 11500,
          "text": "One release store publishes the new element."
        }
      ],
      "entities": [
        {
          "id": "push-diff",
          "explanation": "Same contract — return false when full — but synchronisation moves from a lock to per-cursor atomics.",
          "sourceRefs": [
            {
              "kind": "code",
              "path": "Mutex.hpp",
              "startLine": 39,
              "endLine": 48,
              "revision": "head"
            },
            {
              "kind": "code",
              "path": "Fifo3.hpp",
              "startLine": 54,
              "endLine": 63,
              "revision": "head"
            }
          ],
          "tone": "neutral",
          "type": "diff-panel",
          "label": "Mutex.hpp:39-48 → Fifo3.hpp:54-63",
          "language": "cpp",
          "before": "auto push(T const& value) {\n    std::lock_guard<std::mutex> lock(mutex_);\n\n    if (full(pushCursor_, popCursor_)) {\n        return false;\n    }\n    new (&ring_[pushCursor_ % capacity_]) T(value);\n    ++pushCursor_;\n    return true;\n}",
          "after": "auto push(T const& value) {\n    auto pushCursor = pushCursor_.load(std::memory_order_relaxed);\n    auto popCursor = popCursor_.load(std::memory_order_acquire);\n    if (full(pushCursor, popCursor)) {\n        return false;\n    }\n    new (element(pushCursor)) T(value);\n    pushCursor_.store(pushCursor + 1, std::memory_order_release);\n    return true;\n}",
          "layout": {
            "col": 1,
            "row": 1,
            "colSpan": 12,
            "rowSpan": 6
          }
        },
        {
          "id": "diff-note",
          "sourceRefs": [],
          "tone": "accent",
          "type": "label",
          "text": "No lock: each thread writes only its own cursor, and acquire/release orders the element hand-off.",
          "size": "md",
          "align": "center",
          "layout": {
            "col": 1,
            "row": 7,
            "colSpan": 12,
            "rowSpan": 2
          }
        }
      ],
