    {
      "id": "happens-before",
      "title": "Why the hand-off is safe",
      "kicker": "Correctness",
      "durationMs": 18000,
      "narration": "Correctness comes from one pairing. The producer constructs the element, then stores pushCursor_ with release. The consumer loads pushCursor_ with acquire, so once it sees the new value, the element's construction is visible too.",
      "cues": [
        {
          "atMs": 0,
          "text": "Producer, consumer, and one slot in the ring."
        },
        {
          "atMs": 2500,
          "text": "① The producer constructs T in the slot."
        },
        {
          "atMs": 5500,
          "text": "② Then it publishes: pushCursor_.store(+1, release)."
        },
        {
          "atMs": 9000,
          "text": "③ The consumer loads pushCursor_ with acquire."
        },
        {
          "atMs": 12500,
          "text": "④ Only then does it read the slot — the write is guaranteed visible."
        }
      ],
