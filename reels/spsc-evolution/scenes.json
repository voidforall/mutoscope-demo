    {
      "id": "cache-lines",
      "title": "Give each cursor its own cache line",
      "kicker": "Performance",
      "durationMs": 17000,
      "narration": "Atomic cursors on the same 64-byte line would still fight: every store invalidates the other core's copy. Fifo3 aligns each cursor to 64 bytes, so the producer's writes and the consumer's writes touch different lines.",
      "cues": [
        {
          "atMs": 0,
          "text": "Two cores, two cursors — on one shared cache line."
        },
        {
          "atMs": 3500,
          "text": "Each store invalidates the other core's copy of the line."
        },
        {
          "atMs": 7500,
          "text": "Fifo3: alignas(64) puts each cursor on its own line."
        },
        {
          "atMs": 12000,
          "text": "Writes no longer ping-pong between cores."
        }
      ],
